#include <iostream>
#include <string>
#include <vector>
#include <queue>
using namespace std;

struct Node {
string name;
vector<Node*> children;

Node(string n) {
    name = n;
}

};

Node* root = NULL;

// Search for a member in the tree
Node* searchMember(Node* node, string name) {
if (node == NULL)
return NULL;

if (node->name == name)
    return node;

for (Node* child : node->children) {
    Node* result = searchMember(child, name);

    if (result != NULL)
        return result;
}

return NULL;

}

// Add a family member
void insertMember() {
string name, parentName;

cout << "Enter member name: ";
cin >> name;

if (root == NULL) {
    root = new Node(name);
    cout << "Root member created successfully!\n";
    return;
}

cout << "Enter parent name: ";
cin >> parentName;

Node* parent = searchMember(root, parentName);

if (parent == NULL) {
    cout << "Parent not found!\n";
    return;
}

if (searchMember(root, name) != NULL) {
    cout << "Member already exists!\n";
    return;
}

parent->children.push_back(new Node(name));
cout << "Member added successfully!\n";

}

// Display the family hierarchy
void displayTree(Node* node, int level = 0) {
if (node == NULL)
return;

for (int i = 0; i < level; i++)
    cout << "    ";

cout << "|-- " << node->name << endl;

for (Node* child : node->children)
    displayTree(child, level + 1);

}

// Search for a member and display ancestors
bool showAncestors(Node* node, const string& name) {
if (node == NULL)
return false;

if (node->name == name)
    return true;

for (Node* child : node->children) {
    if (showAncestors(child, name)) {
        cout << node->name << " ";
        return true;
    }
}

return false;

}

void searchAndShowAncestors() {
string name;

cout << "Enter member name: ";
cin >> name;

Node* member = searchMember(root, name);

if (member == NULL) {
    cout << "Member not found!\n";
    return;
}

cout << "Member found: " << member->name << endl;

if (member == root) {
    cout << "This member is the root and has no ancestors.\n";
    return;
}

cout << "Ancestors (nearest first): ";
showAncestors(root, name);
cout << endl;

}

// Display all descendants of a selected member
void showDescendants(Node* node) {
for (Node* child : node->children) {
cout << child->name << endl;
showDescendants(child);
}
}

void displaySelectedDescendants() {
string name;

cout << "Enter member name: ";
cin >> name;

Node* member = searchMember(root, name);

if (member == NULL) {
    cout << "Member not found!\n";
    return;
}

if (member->children.empty()) {
    cout << "No descendants found for " << member->name << ".\n";
    return;
}

cout << "Descendants of " << member->name << ":\n";
showDescendants(member);

}

// Count members at every generation level using BFS
void countGenerations() {
if (root == NULL) {
cout << "Family tree is empty!\n";
return;
}

queue<Node*> q;
q.push(root);

int level = 0;

cout << "\nFamily Members at Each Generation\n";

while (!q.empty()) {
    int count = q.size();

    cout << "Level " << level << ": "
         << count << (count == 1 ? " member" : " members")
         << endl;

    for (int i = 0; i < count; i++) {
        Node* current = q.front();
        q.pop();

        for (Node* child : current->children)
            q.push(child);
    }

    level++;
}

}

// Release dynamically allocated memory
void deleteTree(Node* node) {
if (node == NULL)
return;

for (Node* child : node->children)
    deleteTree(child);

delete node;

}

int main() {
int choice;

do {
    cout << "\n===== FAMILY HIERARCHY SYSTEM =====\n";
    cout << "1. Add Family Member\n";
    cout << "2. Search Member and Display Ancestors\n";
    cout << "3. Display All Descendants\n";
    cout << "4. Count Members at Each Generation\n";
    cout << "5. Display Family Tree\n";
    cout << "6. Exit\n";
    cout << "Enter your choice: ";
    cin >> choice;

    switch (choice) {
        case 1:
            insertMember();
            break;

        case 2:
            searchAndShowAncestors();
            break;

        case 3:
            displaySelectedDescendants();
            break;

        case 4:
            countGenerations();
            break;

        case 5:
            if (root == NULL)
                cout << "Family tree is empty!\n";
            else {
                cout << "\nComplete Family Hierarchy:\n";
                displayTree(root);
            }
            break;

        case 6:
            cout << "Exiting Family Hierarchy System...\n";
            break;

        default:
            cout << "Invalid choice! Please try again.\n";
    }

} while (choice != 6);

deleteTree(root);

return 0;

}
