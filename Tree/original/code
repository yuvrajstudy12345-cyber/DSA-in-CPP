#include <iostream>
#include <string>
#include <vector>
using namespace std;

struct Node {
string name;
vector<Node*> children;

Node(string n) {
    name = n;
}

};

Node* root = NULL;

// Search for a family member
Node* searchMember(Node* node, string name) {
if (node == NULL)
return NULL;

if (node->name == name)
    return node;

for (Node* child : node->children) {
    Node* result = searchMember(child, name);
    if (result != NULL)
        return result;
}

return NULL;

}

// Insert a family member
void insertMember() {
string name, parentName;

cout << "Enter member name: ";
cin >> name;

if (root == NULL) {
    root = new Node(name);
    cout << "Root member added successfully!\n";
    return;
}

cout << "Enter parent name: ";
cin >> parentName;

Node* parent = searchMember(root, parentName);

if (parent == NULL) {
    cout << "Parent not found!\n";
    return;
}

parent->children.push_back(new Node(name));
cout << "Family member added successfully!\n";

}

// Display the family tree
void displayTree(Node* node, int level = 0) {
if (node == NULL)
return;

for (int i = 0; i < level; i++)
    cout << "   ";

cout << "|-- " << node->name << endl;

for (Node* child : node->children)
    displayTree(child, level + 1);

}

// Display ancestors
bool displayAncestors(Node* node, string name) {
if (node == NULL)
return false;

if (node->name == name)
    return true;

for (Node* child : node->children) {
    if (displayAncestors(child, name)) {
        cout << node->name << " ";
        return true;
    }
}

return false;

}

// Display descendants
void displayDescendants(Node* node) {
if (node == NULL)
return;

for (Node* child : node->children) {
    cout << child->name << endl;
    displayDescendants(child);
}

}

// Free allocated memory
void deleteTree(Node* node) {
if (node == NULL)
return;

for (Node* child : node->children)
    deleteTree(child);

delete node;

}

int main() {
int choice;
string name;

do {
    cout << "\n===== FAMILY HIERARCHY TREE =====\n";
    cout << "1. Insert Family Member\n";
    cout << "2. Search Family Member\n";
    cout << "3. Display Family Tree\n";
    cout << "4. Display Ancestors\n";
    cout << "5. Display Descendants\n";
    cout << "6. Exit\n";
    cout << "Enter your choice: ";
    cin >> choice;

    switch (choice) {
        case 1:
            insertMember();
            break;

        case 2:
            cout << "Enter member name to search: ";
            cin >> name;

            if (searchMember(root, name) != NULL)
                cout << "Family member found!\n";
            else
                cout << "Family member not found!\n";
            break;

        case 3:
            if (root == NULL)
                cout << "Family tree is empty!\n";
            else {
                cout << "\nFamily Hierarchy:\n";
                displayTree(root);
            }
            break;

        case 4:
            cout << "Enter member name: ";
            cin >> name;

            if (searchMember(root, name) == NULL) {
                cout << "Family member not found!\n";
            } else if (root->name == name) {
                cout << "No ancestors (Root Member).\n";
            } else {
                cout << "Ancestors: ";
                displayAncestors(root, name);
                cout << endl;
            }
            break;

        case 5:
            cout << "Enter member name: ";
            cin >> name;

            {
                Node* member = searchMember(root, name);

                if (member == NULL)
                    cout << "Family member not found!\n";
                else if (member->children.empty())
                    cout << "No descendants found.\n";
                else {
                    cout << "Descendants:\n";
                    displayDescendants(member);
                }
            }
            break;

        case 6:
            cout << "Exiting program...\n";
            break;

        default:
            cout << "Invalid choice! Try again.\n";
    }

} while (choice != 6);

deleteTree(root);
return 0;

}
